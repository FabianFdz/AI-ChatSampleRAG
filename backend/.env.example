# Port the HTTP server listens on
PORT=3001
# Runtime environment: development | production | test
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Voyage AI API key (required) — https://dash.voyageai.com
VOYAGE_API_KEY=
# Voyage embedding model id (optional, defaults to voyage-4-lite)
VOYAGE_EMBEDDING_MODEL=
# Anthropic API key (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Anthropic model id (optional, defaults to claude-haiku-4-5-20251001 — unset falls back to the default, but a set-and-blank value fails fast)
ANTHROPIC_MODEL=
